{
  "name": "plutio-mcp",
  "version": "0.1.0",
  "description": "Business-agnostic MCP server for Plutio",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/http.js",
    "check": "node --check src/index.js && node --check src/http.js && node --check src/server.js && node --check src/client.js && node --check src/config.js && node --check src/tools.js && node --check src/schemas.js",
    "print-tools": "node src/index.js --print-tools",
    "self-test": "node src/index.js --self-test"
  },
  "keywords": [
    "mcp",
    "plutio",
    "openclaw"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.1.12"
  }
}
